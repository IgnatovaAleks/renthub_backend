// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  fullName    String
  role        Role         @default(USER) // USER, ADMIN, COMPANY
  company     Company?     @relation(fields: [companyId], references: [id])
  companyId   Int?
  reservations Reservation[]
  tokens      Token[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Token {
  id          Int         @id @default(autoincrement())
  token       String      @unique
  type        TokenType
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
  expiresAt   DateTime
  revoked     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  device      String?   // (опционално) „iPhone 12“, „Chrome on Windows“
  ip          String?   // (опционално) IP адреса
}

model Company {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  cars        Car[]
  apartments  Apartment[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Car {
  id          Int          @id @default(autoincrement())
  model       String
  brand       String
  year        Int
  pricePerDay Float
  isAvailable Boolean      @default(true)
  company     Company      @relation(fields: [companyId], references: [id])
  companyId   Int
  reservations Reservation[]
  images      CarImage[] @relation("CarToCarImage")
}

model Apartment {
  id          Int          @id @default(autoincrement())
  title       String
  location    String
  description String?
  pricePerNight Float
  isAvailable Boolean      @default(true)
  company     Company      @relation(fields: [companyId], references: [id])
  companyId   Int
  reservations Reservation[]
  images      ApartmentImage[] @relation("ApartmentToApartmentImage")
}

model Reservation {
  id            Int        @id @default(autoincrement())
  user          User       @relation(fields: [userId], references: [id])
  userId        Int
  car           Car?       @relation(fields: [carId], references: [id])
  carId         Int?
  apartment     Apartment? @relation(fields: [apartmentId], references: [id])
  apartmentId   Int?
  startDate     DateTime
  endDate       DateTime
  status        ReservationStatus @default(PENDING)
  totalPrice    Float
  qrCode        String?
  createdAt     DateTime   @default(now())
}

model CarImage {
  id     Int  @id @default(autoincrement())
  url    String
  car    Car  @relation("CarToCarImage", fields: [carId], references: [id])
  carId  Int
}

model ApartmentImage {
  id     Int  @id @default(autoincrement())
  url    String
  apartment    Apartment  @relation("ApartmentToApartmentImage", fields: [apartmentId], references: [id])
  apartmentId  Int
}

enum Role {
  USER
  ADMIN
  COMPANY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TokenType {
  REFRESH
  RESET_PASSWORD
  EMAIL_VERIFICATION
}